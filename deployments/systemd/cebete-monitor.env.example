# Copy to /etc/cebete-monitor.env (chmod 600) on the VPS.
#
# Telegram (required)
TELEGRAM_BOT_TOKEN=123456:replace_me
TELEGRAM_CHAT_ID=123456789

# Timezone (recommended)
TZ=Asia/Jakarta

# State (for cursor + idempotency)
STATE_DIR=/var/lib/cebete-monitor

# SSH watcher (Ubuntu typically uses ssh.service)
SSH_JOURNAL_UNIT=ssh.service

# Daily exam summary
CBTLMS_DSN=postgres://cbtlms:replace_me@127.0.0.1:5432/cbtlms?sslmode=disable
RECONNECT_ANOMALY_THRESHOLD=10

